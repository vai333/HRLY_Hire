# --- Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=
SCORING_MODE=lenient

# --- Supabase (Project settings → API). Service-role key stays server-side only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=cvs

# --- Resend (https://resend.com/api-keys). onboarding@resend.dev only delivers to your own Resend account email;
# verify a domain to send to candidates.
RESEND_API_KEY=
EMAIL_FROM=Kargo Hiring <onboarding@resend.dev>
EMAIL_REPLY_TO=

# --- Branding / sender
COMPANY_NAME=Kargo
FOUNDER_NAME=Arjun Mehta
FOUNDER_TITLE=Founder & CEO

# --- Protects the deployed dashboard. Leave empty only for local dev.
APP_PASSCODE=

# Local dev: Vite runs on 5173 and proxies /api to 8000, so CORS rarely matters.
CORS_ORIGINS=http://localhost:5173
